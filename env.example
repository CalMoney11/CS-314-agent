# Copy this file to .env and fill in your real values. .env is gitignored.
# Get a key at https://console.anthropic.com (API usage is billed separately from Pro).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which model terminal.py uses
CLAUDE_MODEL=claude-sonnet-5-5

SLACK_BOT_TOKEN=xoxb-...   # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...   # Basic Information -> App-Level Token (connections:write)

# ---- Phone app backend (backend/) ----
# Password the phone sends to the backend. deploy.sh generates one if missing.
APP_API_TOKEN=
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://canvas.uoregon.edu
APP_TIMEZONE=America/Los_Angeles
# Optional: comma-separated Google calendar IDs (default: primary)
GOOGLE_CALENDAR_IDS=primary
# Optional: model for the in-app assistant (default: claude-opus-5-5)
CHAT_MODEL=claude-opus-5-5
